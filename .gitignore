# Cursor / Antigravity local state — rules are tracked so everyone gets the same
# agent conventions. Everything else under .cursor/ stays local.
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Local download copies at repo root — canonical copies live in docs/
/TASK (3).md
/TEAM_ASSIGNMENTS (3).md
/GIT_WORKFLOW (3).md
/CONVENTIONS.md

# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/

# Secrets — .env is never committed, in backend/ or frontend/. Only .env.example is.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Test / coverage
coverage/
*.lcov

# Database dumps (Task 33) — never commit live backups
backups/*
!backups/.gitkeep

# Caches
.eslintcache
*.tsbuildinfo

# Database dumps from Task 33 backup rehearsal — never commit live data
/backups/*
!/backups/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
