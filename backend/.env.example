# Copy to .env and fill in locally. .env is gitignored — never commit real values.
# Provider keys (Fayda, SMTP) belong in this file only, never in frontend/.

NODE_ENV=development
PORT=4000
API_PREFIX=api

# Frontend origin allowed through CORS (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# Postgres — used from Task 2 (schema v1) onward
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=isms_dev
DB_SSL=false
DB_LOGGING=false

# Auth — Task 3
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Fayda National ID sandbox — Task 9, backend only
FAYDA_BASE_URL=
FAYDA_API_KEY=

# SMTP for notification emails — Task 25, backend only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
