# Copy to .env and fill in locally. .env is gitignored — never commit real values.
# Provider keys (SMTP and future gateways) belong in this file only, never in frontend/.
#
# Database defaults match the root docker-compose.yml (`docker compose up -d`).

NODE_ENV=development
PORT=4000
API_PREFIX=api

# Frontend origin allowed through CORS (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# Postgres — from Task 2 onward. Use `postgres` for migrations; use `isms_app` for
# the running API / RLS checks (Task 3+). Same password in both cases locally.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=devpassword
DB_NAME=isms_dev
DB_SSL=false
DB_LOGGING=false

# Auth — Task 3. Any non-empty string works locally; use a real generated secret in
# any deployed environment.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Savings → loan eligibility ceiling (Task 12 / DECISIONS.md D3).
# maxLoan = sum(available savings balances) × this multiplier.
SAVINGS_LOAN_MULTIPLIER=3

# SMTP for notification emails — Task 25, backend only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
