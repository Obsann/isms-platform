# Copy to .env and fill in locally. .env is gitignored — never commit real values.
# Provider keys (SMTP and future gateways) belong in this file only, never in frontend/.
#
# Database defaults match the root docker-compose.yml (`docker compose up -d`).

NODE_ENV=development
PORT=4000
API_PREFIX=api

# Frontend origin allowed through CORS (Next.js dev server).
# On Render set this to the Vercel origin, e.g. https://isms-platform.vercel.app
# — never `*`.
CORS_ORIGIN=http://localhost:3000

# Postgres — from Task 2 onward. Use `postgres` (or DATABASE_URL owner) for
# migrations; use `isms_app` for the running API / RLS checks (Task 3+).
# Same password in both cases locally.
# Compose publishes host port 5532 (`5532:5432`). Backup scripts use docker exec
# and ignore this port.
#
# Render: leave DB_HOST/DB_PORT unset and inject DATABASE_URL (internal
# connection string). Overlay DB_USERNAME=isms_app and DB_PASSWORD=<app role>
# only if that role exists. SKIP_APP_ROLE=1 skips CREATE ROLE and uses the
# DATABASE_URL owner for the API as well as migrations/seed.
# External Render URLs need TLS; the app enables ssl automatically when the
# host contains render.com. Internal URLs usually do not need DB_SSL=true.
# DATABASE_URL=
# DB_ADMIN_USERNAME=isms_owner
# SKIP_APP_ROLE=1
# SKIP_SEED=1
DB_HOST=localhost
DB_PORT=5532
DB_USERNAME=postgres
DB_PASSWORD=devpassword
DB_NAME=isms_dev
DB_SSL=false
DB_LOGGING=false

# Auth — Task 3. Any non-empty string works locally; use a real generated secret in
# any deployed environment.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Savings → loan eligibility ceiling (Task 12 / DECISIONS.md D3).
# maxLoan = sum(available savings balances) × this multiplier.
SAVINGS_LOAN_MULTIPLIER=3

# Step-up email OTP for password reset/change and high-value cash movements.
# Threshold is inclusive (≥). Codes expire in OTP_EXPIRY_SECONDS.
HIGH_VALUE_OTP_THRESHOLD=100000.00
OTP_EXPIRY_SECONDS=300

# SMTP for notification emails — Task 25, backend only.
# Gmail SMTP (pilot): host smtp.gmail.com, port 587, SMTP_SECURE=false, and an
# App Password — never a normal Gmail password. Production would swap the same
# Nodemailer settings to Resend/Brevo/etc.
# SMTP_OVERRIDE_TO (optional): send every notification to one inbox so the
# Task 25 verify step works without changing seeded member emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASS is accepted as an alias for SMTP_PASSWORD.
SMTP_FROM=
SMTP_OVERRIDE_TO=

# Chapa member savings deposits and Telebirr/M-PESA withdrawals — paste your
# secret here (never commit it). Dashboard test key looks like CHASECK_TEST-… .
# Empty key = hosted checkout will not open; withdrawals can still be mocked.
# Set the same vars on Render only — never in frontend/.env or Vercel.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Public API URL Chapa should POST to, e.g. https://isms-api.onrender.com/api/webhooks/chapa
CHAPA_CALLBACK_URL=http://localhost:4000/api/webhooks/chapa
# Optional. Transfer approval URL in the Chapa dashboard:
# http://localhost:4000/api/webhooks/chapa/transfer-approval
CHAPA_TRANSFER_APPROVAL_SECRET=
# Optional overrides if GET /v1/banks cannot resolve Telebirr / M-PESA.
CHAPA_TELEBIRR_BANK_CODE=
CHAPA_MPESA_BANK_CODE=
# Browser origin after hosted checkout. Falls back to CORS_ORIGIN when unset.
FRONTEND_URL=http://localhost:3000
