# .env.example
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is gitignored.
# Provider credentials (SMTP, gateways) live in backend/ only.

# NestJS API — port 4000, global prefix `api` (not versioned).
# Vercel: set this to the public Render origin including `/api`, e.g.
# https://isms-api.onrender.com/api
# NEXT_PUBLIC_* is inlined at `next build` — change it, then redeploy.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
